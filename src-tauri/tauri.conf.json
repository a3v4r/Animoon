{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AniLibrix Reborn",
  "version": "2.0.0",
  "identifier": "com.a3v4r.anilibrix",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AniLibrix",
        "width": 1280,
        "height": 760,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "backgroundColor": "#0b0c10",
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' https://anilibria.top https://aniliberty.top https://api.anilibria.app",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https://*.libria.fun",
        "media-src": "'self' blob: https://*.libria.fun",
        "worker-src": "blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-src": "'none'",
        "frame-ancestors": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "appimage",
      "deb",
      "rpm"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": [
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav"
        ]
      },
      "rpm": {
        "recommends": [
          "gstreamer1-plugins-good",
          "gstreamer1-plugins-bad-free",
          "gstreamer1-plugin-libav"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI4MjdBRjQyNTZCRjhGM0UKUldRK2o3OVdRcThuS0FCYS9lSzRDcmNvZFRXTkdkd3VmZzduS3A4ODhUK1pmbzhFYTJKKzU3WUoK",
      "endpoints": [
        "https://github.com/a3v4r/anilibrix-reborn/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
